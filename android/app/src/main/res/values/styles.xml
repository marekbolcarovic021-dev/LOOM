<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Main LOOM application theme -->
    <style name="AppTheme.NoActionBar"
        parent="Theme.AppCompat.DayNight.NoActionBar">

        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- LOOM dark background -->
        <item name="android:windowBackground">#0F172A</item>
        <item name="android:background">#0F172A</item>

        <!-- White system bar icons -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Legacy Android versions -->
        <item name="android:statusBarColor">#0F172A</item>
        <item name="android:navigationBarColor">#0F172A</item>

    </style>

    <!-- Splash screen theme -->
    <style name="AppTheme.NoActionBarLaunch"
    parent="Theme.SplashScreen">

    <item name="windowSplashScreenBackground">#0F172A</item>

    <item name="postSplashScreenTheme">
        @style/AppTheme.NoActionBar
    </item>

</style>

</resources>